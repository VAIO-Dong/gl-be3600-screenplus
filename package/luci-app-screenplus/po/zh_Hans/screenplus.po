msgstr "启用定时开关屏幕"

msgid "Use ScreenPlus"
msgstr "启用 ScreenPlus"

msgid "Used for headings, highlights, active switches and healthy connections."
msgstr "用于标题、重点内容、已开启的开关和正常连接。"

msgid "Used for labels, units, supporting information and unavailable connections."
msgstr "用于标签、单位、辅助信息和不可用的连接。"

msgid "Used for separators and the track of an inactive switch."
msgstr "用于分割线和未开启开关的轨道。"

msgid "Used for the clock, important values, addresses, Wi-Fi names and passwords."
msgstr "用于时钟、重要数值、地址、Wi-Fi 名称和密码。"

msgid "Used when a service reports a problem."
msgstr "用于服务报告异常时。"

msgid "View OpenClash activity and control it directly from the screen."
msgstr "查看 OpenClash 运行情况，并直接从屏幕控制开关。"

