msgstr "活动连接数"

msgid "Active"
msgstr "启用"

msgid "Always show password"
msgstr "始终显示密码"

msgid "Arrange the swipe order, then open a page tab to choose what appears on screen. The layout adapts automatically to your choices."
msgstr "先设置页面滑动顺序，再打开各页面标签选择屏幕上显示的内容；布局会根据选择自动调整。"

msgid "Available but not enabled"
msgstr "已检测但未启用"

