#!/bin/sh /etc/rc.common

START=81
STOP=19
USE_PROCD=1

start_service() {
	local brightness
	/usr/libexec/screenplus-migrate 2>/dev/null
	config_load screenplus
	config_get brightness main brightness 5
	case "$brightness" in
		''|*[!0-9]*) brightness=5 ;;
	esac
	[ "$brightness" -ge 1 ] 2>/dev/null || brightness=1
	[ "$brightness" -le 11 ] 2>/dev/null || brightness=11

	echo "$brightness" > /sys/class/backlight/soc:backlight/brightness 2>/dev/null

	procd_open_instance
	# Match the vendor screen service so UI work is not delayed by router load.
	procd_set_param nice -20
	procd_set_param command /usr/libexec/screenplus-run
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/screenplus
	procd_close_instance
}

reload_service() {
	procd_send_signal screenplus
}

service_triggers() {
	procd_add_reload_trigger screenplus system
}
