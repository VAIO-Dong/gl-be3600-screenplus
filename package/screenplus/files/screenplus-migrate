#!/bin/sh

# Idempotent migration through the compact screen-schedule schema.
schema_version="$(uci -q get screenplus.main.schema_version)"
[ "$schema_version" = "16" ] && exit 0

get_or_default() {
	value="$(uci -q get "$1")"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$2"
}

migrate_page_order() {
	uci set screenplus.page_order=page_order
	for page_default in 'home 10' 'traffic 20' 'status 30' \
		'wifi 40' 'network 50' 'openclash 60'; do
		set -- $page_default
		order="$(uci -q get "screenplus.page_order.$1")"
		[ -n "$order" ] || order="$(get_or_default "screenplus.$1.order" "$2")"
		uci set "screenplus.page_order.$1=$order"
		uci -q delete "screenplus.$1.order"
	done
}

ensure_page_order_values() {
	uci set screenplus.page_order=page_order
	for page_default in 'home 10' 'traffic 20' 'status 30' \
		'wifi 40' 'network 50' 'openclash 60'; do
		set -- $page_default
		value="$(uci -q get "screenplus.page_order.$1")"
		[ -n "$value" ] || uci set "screenplus.page_order.$1=$2"
	done
}

canonicalise_network_fields() {
	fields="$(uci -q get screenplus.network.field)"
	[ -n "$fields" ] || fields='ethernet repeater tethering cellular wan_detail lan'
	uci -q delete screenplus.network.field
	added=0
	for field in ethernet repeater tethering cellular wan_detail lan; do
		case " $fields " in
			*" $field "*) uci add_list "screenplus.network.field=$field"; added=1 ;;
		esac
	done
	[ "$added" = "1" ] || uci add_list screenplus.network.field=none
}

align_openclash_traffic_fields() {
	fields="$(uci -q get screenplus.openclash.field)"
	case " $fields " in
		*' rates '*|*' totals '*)
			case " $fields " in *' rates '*) ;; *) uci add_list screenplus.openclash.field=rates ;; esac
			case " $fields " in *' totals '*) ;; *) uci add_list screenplus.openclash.field=totals ;; esac
			;;
	esac
}

bind_existing_backgrounds() {
	for page in home status traffic network wifi openclash; do
		[ -f "/usr/share/screenplus/backgrounds/$page.rgb565" ] || continue
		uci set "screenplus.$page.background=$page.rgb565"
	done
	if [ -f /usr/share/screenplus/backgrounds/global.rgb565 ]; then
		uci set screenplus.appearance.background_mode=global
	fi
}

migrate_connection_colours() {
	uci set screenplus.appearance.standby="$(get_or_default \
		screenplus.appearance.standby '#4b9fff')"
}

migrate_divider_colour() {
	divider="$(uci -q get screenplus.appearance.border)"
	if [ -z "$divider" ] || [ "$divider" = "#4f87b8" ]; then
		uci set screenplus.appearance.border='#3b424a'
	fi
}

add_openclash_resources() {
	fields="$(uci -q get screenplus.openclash.field)"
	case " $fields " in
		*" resources "*) ;;
		*) uci add_list screenplus.openclash.field=resources ;;
	esac
}

add_traffic_connections() {
	fields="$(uci -q get screenplus.traffic.field)"
	case " $fields " in
		*" connections "*) ;;
		*) uci add_list screenplus.traffic.field=connections ;;
	esac
}

ensure_schedule_range() {
	prefix="screenplus.main.schedule_$1"
	if [ -n "$2" ]; then
		uci set "${prefix}_enabled=$(get_or_default "${prefix}_enabled" "$2")"
	fi
	uci set "${prefix}_on=$(get_or_default "${prefix}_on" "$3")"
	uci set "${prefix}_off=$(get_or_default "${prefix}_off" "$4")"
}

ensure_screen_schedule() {
	uci set screenplus.main.schedule_enabled="$(get_or_default \
		screenplus.main.schedule_enabled 0)"
	uci set screenplus.main.schedule_mode="$(get_or_default \
		screenplus.main.schedule_mode daily)"
	ensure_schedule_range daily '' 08:00 23:00
	ensure_schedule_range weekday 1 09:00 19:00
	ensure_schedule_range weekend 0 09:00 19:00
	for day in monday tuesday wednesday thursday friday saturday sunday; do
		ensure_schedule_range "$day" 1 08:00 23:00
	done
}

finish_migration() {
	uci -q delete screenplus.main.restore_official_on_remove
	uci -q delete screenplus.appearance.surface
	uci -q delete screenplus.appearance.absent
	migrate_divider_colour
	add_openclash_resources
	add_traffic_connections
	ensure_page_order_values
	canonicalise_network_fields
	align_openclash_traffic_fields
	ensure_screen_schedule
	uci set screenplus.main.schema_version=16
	uci commit screenplus
	exit 0
}

if [ "$schema_version" = "15" ]; then
	finish_migration
fi

if [ "$schema_version" = "14" ]; then
	finish_migration
fi

if [ "$schema_version" = "13" ]; then
	finish_migration
fi

if [ "$schema_version" = "12" ]; then
	finish_migration
fi

if [ "$schema_version" = "11" ]; then
	finish_migration
fi

if [ "$schema_version" = "10" ]; then
	finish_migration
fi

if [ "$schema_version" = "9" ]; then
	finish_migration
fi

if [ "$schema_version" = "8" ]; then
	finish_migration
fi

if [ "$schema_version" = "7" ]; then
	finish_migration
fi

if [ "$schema_version" = "6" ]; then
	finish_migration
fi

if [ "$schema_version" = "5" ]; then
	migrate_connection_colours
	finish_migration
fi

if [ "$schema_version" = "4" ]; then
	uci set screenplus.appearance.background_mode="$(get_or_default \
		screenplus.appearance.background_mode page)"
	migrate_page_order
	bind_existing_backgrounds
	migrate_connection_colours
	finish_migration
fi

# Schema 3 already has the current six-page structure. Only replace the fields
# whose meaning changed so unrelated user page choices remain untouched.
if [ "$schema_version" = "3" ]; then
	uci -q delete screenplus.network.field
	uci add_list screenplus.network.field=ethernet
	uci add_list screenplus.network.field=repeater
	uci add_list screenplus.network.field=tethering
	uci add_list screenplus.network.field=cellular
	uci add_list screenplus.network.field=wan_detail
	uci add_list screenplus.network.field=lan
	uci set screenplus.appearance.background_mode="$(get_or_default \
		screenplus.appearance.background_mode page)"
	migrate_page_order
	bind_existing_backgrounds
	migrate_connection_colours
	finish_migration
fi

primary="$(uci -q get screenplus.appearance.primary)"
[ -n "$primary" ] || primary="$(get_or_default screenplus.appearance.foreground '#ffffff')"
[ "$primary" = "#f4f7fb" ] && primary='#ffffff'
accent="$(get_or_default screenplus.appearance.accent '#37f59a')"
[ "$accent" = "#41d695" ] && accent='#37f59a'
background="$(get_or_default screenplus.appearance.background '#030912')"
[ "$background" = "#08111f" ] && background='#030912'
uci set screenplus.appearance.primary="$primary"
uci set screenplus.appearance.secondary="$(get_or_default screenplus.appearance.secondary '#dcecff')"
uci set screenplus.appearance.accent="$accent"
uci set screenplus.appearance.background="$background"
uci set screenplus.appearance.border="$(get_or_default screenplus.appearance.border '#3b424a')"
uci set screenplus.appearance.warning="$(get_or_default screenplus.appearance.warning '#ffdc55')"
uci set screenplus.appearance.error="$(get_or_default screenplus.appearance.error '#ff5c70')"
migrate_connection_colours
uci set screenplus.appearance.background_mode="$(get_or_default \
	screenplus.appearance.background_mode page)"
uci -q delete screenplus.appearance.foreground
uci set screenplus.main.page_transition=slide

uci set screenplus.status=page
uci -q delete screenplus.status.field
uci add_list screenplus.status.field=cpu
uci add_list screenplus.status.field=memory
uci add_list screenplus.status.field=fan

uci set screenplus.traffic=page
uci set screenplus.traffic.enabled="$(get_or_default screenplus.traffic.enabled 1)"
uci set screenplus.traffic.order="$(get_or_default screenplus.traffic.order 25)"
uci -q delete screenplus.traffic.field
uci add_list screenplus.traffic.field=rates
uci add_list screenplus.traffic.field=history

network_enabled="$(uci -q get screenplus.network.enabled)"
[ -n "$network_enabled" ] || network_enabled="$(get_or_default screenplus.internet.enabled 1)"
network_order="$(uci -q get screenplus.network.order)"
[ -n "$network_order" ] || network_order="$(get_or_default screenplus.internet.order 30)"
network_background="$(uci -q get screenplus.internet.background)"
uci set screenplus.network=page
uci set screenplus.network.enabled="$network_enabled"
uci set screenplus.network.order="$network_order"
uci -q delete screenplus.network.field
uci add_list screenplus.network.field=ethernet
uci add_list screenplus.network.field=repeater
uci add_list screenplus.network.field=tethering
uci add_list screenplus.network.field=cellular
uci add_list screenplus.network.field=wan_detail
uci add_list screenplus.network.field=lan
if [ "$network_background" = "internet.rgb565" ] &&
   [ -f /usr/share/screenplus/backgrounds/internet.rgb565 ]; then
	mv -f /usr/share/screenplus/backgrounds/internet.rgb565 \
		/usr/share/screenplus/backgrounds/network.rgb565
	uci set screenplus.network.background=network.rgb565
fi

uci set screenplus.wifi=page
uci -q delete screenplus.wifi.field
uci add_list screenplus.wifi.field=wifi_2g
uci add_list screenplus.wifi.field=wifi_5g

openclash_enabled="$(uci -q get screenplus.openclash.enabled)"
[ -n "$openclash_enabled" ] || openclash_enabled="$(get_or_default screenplus.ports.enabled 1)"
openclash_order="$(uci -q get screenplus.openclash.order)"
[ -n "$openclash_order" ] || openclash_order="$(get_or_default screenplus.ports.order 50)"
openclash_background="$(uci -q get screenplus.ports.background)"
uci set screenplus.openclash=page
uci set screenplus.openclash.enabled="$openclash_enabled"
uci set screenplus.openclash.order="$openclash_order"
uci -q delete screenplus.openclash.field
uci add_list screenplus.openclash.field=rates
uci add_list screenplus.openclash.field=connections
uci add_list screenplus.openclash.field=totals
uci add_list screenplus.openclash.field=resources
if [ "$openclash_background" = "ports.rgb565" ] &&
   [ -f /usr/share/screenplus/backgrounds/ports.rgb565 ]; then
	mv -f /usr/share/screenplus/backgrounds/ports.rgb565 \
		/usr/share/screenplus/backgrounds/openclash.rgb565
	uci set screenplus.openclash.background=openclash.rgb565
fi

uci -q delete screenplus.internet
uci -q delete screenplus.ports
migrate_page_order
bind_existing_backgrounds
finish_migration
