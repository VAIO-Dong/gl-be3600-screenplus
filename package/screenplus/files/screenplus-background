#!/bin/sh

set -eu
umask 077

action="${1:-}"
page="${2:-}"
case "$page" in
	global|home|status|traffic|network|wifi|openclash) ;;
	*) echo "invalid page" >&2; exit 2 ;;
esac

directory=/usr/share/screenplus/backgrounds
destination="$directory/$page.rgb565"
input="/tmp/screenplus-background-$page.b64"
temporary="$directory/.$page.rgb565.$$"

cleanup() {
	rm -f "$temporary"
}
trap cleanup EXIT INT TERM

reload_screenplus() {
	[ "$(uci -q get screenplus.main.enabled)" = "1" ] || return 0
	/etc/init.d/screenplus reload 2>/dev/null || true
}

case "$action" in
	install)
		[ -f "$input" ] && [ ! -L "$input" ] || {
			echo "upload is missing or unsafe" >&2
			exit 1
		}
		encoded_size="$(wc -c < "$input")"
		[ "$encoded_size" -le 60000 ] || {
			echo "upload is too large" >&2
			exit 1
		}
		mkdir -p "$directory"
		base64 -d "$input" > "$temporary" || {
			echo "invalid base64 data" >&2
			exit 1
		}
		decoded_size="$(wc -c < "$temporary")"
		[ "$decoded_size" -eq 43168 ] || {
			echo "background must decode to exactly 43168 bytes" >&2
			exit 1
		}
		chmod 0644 "$temporary"
		mv -f "$temporary" "$destination"
		rm -f "$input"
		if [ "$page" = "global" ]; then
			uci set screenplus.appearance.background_mode=global
		else
			uci set "screenplus.$page.background=$page.rgb565"
			uci set screenplus.appearance.background_mode=page
		fi
		uci commit screenplus
		reload_screenplus
		;;
	remove)
		rm -f "$destination" "$input"
		if [ "$page" = "global" ]; then
			[ "$(uci -q get screenplus.appearance.background_mode)" != "global" ] || \
				uci set screenplus.appearance.background_mode=page
		else
			uci -q delete "screenplus.$page.background"
		fi
		uci commit screenplus
		reload_screenplus
		;;
	preview)
		[ -f "$destination" ] && [ ! -L "$destination" ] || exit 3
		[ "$(wc -c < "$destination")" -eq 43168 ] || exit 4
		base64 "$destination"
		;;
	*)
		echo "usage: screenplus-background install|remove|preview PAGE" >&2
		exit 2
		;;
esac
