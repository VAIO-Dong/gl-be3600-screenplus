config screenplus 'main'
	option schema_version '3'
	option enabled '1'
	option language 'zh_cn'
	option brightness '5'
	option idle_timeout '180'
	option always_on '0'
	option swipe_loop '1'
	option page_transition 'slide'
	option auto_carousel '0'
	option carousel_interval '10'
	option password_mode 'tap'
	option rotation '90'
	option restore_official_on_remove '1'

config appearance 'appearance'
	option primary '#ffffff'
	option secondary '#dcecff'
	option accent '#37f59a'
	option background '#030912'
	option surface '#0a1828'
	option border '#4f87b8'
	option warning '#ffdc55'
	option error '#ff5c70'
	option overlay_opacity '35'

config page 'home'
	option enabled '1'
	option order '10'
	list field 'time'
	list field 'date'
	list field 'weekday'

config page 'status'
	option enabled '1'
	option order '20'
	list field 'cpu'
	list field 'memory'
	list field 'fan'

config page 'traffic'
	option enabled '1'
	option order '25'
	list field 'rates'
	list field 'history'

config page 'network'
	option enabled '1'
	option order '30'
	list field 'port_1'
	list field 'port_2'
	list field 'wifi'

config page 'wifi'
	option enabled '1'
	option order '40'
	list field 'wifi_2g'
	list field 'wifi_5g'

config page 'openclash'
	option enabled '1'
	option order '50'
	list field 'rates'
	list field 'connections'
	list field 'totals'
