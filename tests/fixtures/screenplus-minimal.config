config screenplus 'main'
	option enabled '1'
	option language 'en'
	option brightness '7'
	option rotation '270'
	option always_on '1'
	option swipe_loop '0'
	option page_transition 'slide'
	option auto_carousel '1'
	option carousel_interval '15'
	option password_mode 'hidden'

config appearance 'appearance'
	option primary '#ffffff'
	option secondary '#dcecff'
	option accent '#0088ff'
	option background '#000011'
	option surface '#081522'
	option border '#5c8db8'
	option warning '#ffcc44'
	option error '#ff4466'
	option absent '#8a939f'
	option standby '#4b9fff'
	option background_mode 'page'

config page_order 'page_order'
	option home '30'
	option status '20'
	option traffic '25'
	option network '10'
	option wifi '40'
	option openclash '50'

config page 'home'
	option enabled '1'
	list field 'time'

config page 'status'
	option enabled '0'
	list field 'cpu'

config page 'traffic'
	option enabled '1'
	list field 'rates'
	list field 'history'

config page 'network'
	option enabled '1'
	list field 'lan'
	list field 'ethernet'
	list field 'repeater'
	list field 'tethering'
	list field 'cellular'
	list field 'wan_detail'

config page 'wifi'
	option enabled '1'
	list field 'wifi_2g'
	list field 'wifi_5g'

config page 'openclash'
	option enabled '1'
	list field 'rates'
	list field 'connections'
	list field 'totals'
